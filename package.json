{
  "name": "amas-plant-corner",
  "version": "1.0.0",
  "description": "Single-page website for Ama's Plant Corner, a neighbourhood plant shop in Accra.",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "stylelint \"**/*.css\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnsonWalker-cmd/ama_plant_corner.git"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/JohnsonWalker-cmd/ama_plant_corner/issues"
  },
  "homepage": "https://github.com/JohnsonWalker-cmd/ama_plant_corner#readme",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0"
  },
  "lint-staged": {
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,css,js,json,yml}": "prettier --write"
  }
}
